{
  "name": "lootupspace-monorepo",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:api": "npm run dev --workspace=apps/api",
    "dev:web": "npm run dev --workspace=apps/web",
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "prisma:generate": "npm run prisma:generate --workspace=packages/database",
    "prisma:seed": "npm run prisma:seed --workspace=packages/database"
  },
  "devDependencies": {
    "autoprefixer": "^10.6.2",
    "typescript": "^5.4.5"
  }
}
